        {
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "hide": false,
          "query": "from(bucket: \"openems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) =>\n    r._measurement == \"data\" and\n    r._field == \"_sum/EssActivePower\"\n  )\n  |> map(fn: (r) => ({\n      r with _value: if r._value < 0.0 then float(v: -r._value) else 0.0\n    })\n  )\n  |> rename(columns: {_value: \"ess_charge_load\"})\n  // Keep only the columns Grafana needs for plotting\n  |> keep(columns: [\"_time\", \"ess_charge_load\"])",
          "refId": "ess_charge_load"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "hide": false,
          "query": "from(bucket: \"openems\")\n  |> range(start: v.timeRangeStart, stop:v.timeRangeStop)\n  |> filter(fn: (r) =>\n    r._measurement == \"data\" and\n    (\n        r._field == \"meter3/ActivePower\"\n    )\n  )",
          "refId": "pure_load"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "hide": false,
          "query": "from(bucket: \"openems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) =>\n    r._measurement == \"data\" and\n    (\n      r._field == \"meter2/ActivePower\" or\n      r._field == \"meter3/ActivePower\" or\n      r._field == \"_sum/EssActivePower\"\n    )\n  )\n  // Conditionally map values before the sum\n  |> map(fn: (r) => ({\n      r with\n      _value:\n        if r._field == \"_sum/EssActivePower\" then\n          // If it is the ESS field, apply the special logic\n          (if r._value < 0.0 then float(v: -r._value) else 0.0)\n        else\n          // Otherwise, use the original value\n          float(v: r._value)\n    })\n  )\n  // Group data by time to combine fields\n  |> group(columns: [\"_time\"])\n  // Calculate the sum of the (now modified) values\n  |> sum()\n  // Set a new name for the resulting field\n  |> set(key: \"_field\", value: \"TotalActivePower\")\n  // Ungroup to create a single table\n  |> group()",
          "refId": "total"
        }
      ],
      "title": "Consumption (meter2, meter3)",
      "type": "timeseries"
